<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_todo"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#AFECFF"
    tools:context=".MainActivity">

    <ImageView
        android:id="@+id/imageView_main_cover"
        android:layout_width="500dp"
        android:layout_height="500dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.505"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/title"
        tools:layout_editor_absoluteY="-60dp" />

    <TextView
        android:id="@+id/textView_main_desc"
        android:layout_width="369dp"
        android:layout_height="128dp"
        android:fontFamily="@font/baloo"
        android:text="Ready to ease the pain of productivity? \n Welcome to Pain au Chocolat!\n"
        android:textAlignment="center"
        android:textColor="#1C8ABC"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView_main_cover"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/button_main_login"
        android:layout_width="128dp"
        android:layout_height="60dp"
        android:layout_marginTop="46dp"
        android:backgroundTint="#E77584"
        android:fontFamily="@font/baloo"
        android:text="Login"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/button_main_signup"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_main_desc"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/button_main_signup"
        android:layout_width="148dp"
        android:layout_height="61dp"
        android:layout_marginTop="44dp"
        android:backgroundTint="#62B1D5"
        android:fontFamily="@font/baloo"
        android:text="Sign up"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/button_main_login"
        app:layout_constraintTop_toBottomOf="@+id/textView_main_desc"
        app:layout_constraintVertical_bias="0.0" />
</androidx.constraintlayout.widget.ConstraintLayout>

