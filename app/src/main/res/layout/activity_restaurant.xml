<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/imageView_restaurant_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scaleType="fitXY"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:srcCompat="@drawable/rundown_exterior" />

    <TextView
        android:id="@+id/textView_restaurant_currency"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="155dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="79dp"
        android:layout_marginBottom="605dp"
        android:fontFamily="@font/baloo"
        android:text="TextView"
        android:textColor="@color/white"
        android:textSize="24sp"
        app:layout_constraintBottom_toTopOf="@+id/button_restaurant_focus"
        app:layout_constraintEnd_toStartOf="@+id/imageView_restaurant_upgrade"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/imageView_restaurant_list"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#EFE7DB"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:padding="4dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/imageView_restaurant_sleepTracker"
        app:layout_constraintStart_toStartOf="@+id/imageView_restaurant_avatar"
        app:layout_constraintTop_toBottomOf="@+id/imageView_restaurant_avatar"
        app:srcCompat="@drawable/todo_button" />

    <Button
        android:id="@+id/button_restaurant_focus"
        android:layout_width="223dp"
        android:layout_height="62dp"
        android:layout_marginBottom="16dp"
        android:backgroundTint="#E66370"
        android:fontFamily="@font/baloo"
        android:text="Focus!"
        android:textSize="28sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/textView_restaurant_currency" />


    <ImageView
        android:id="@+id/imageView_restaurant_sleepTracker"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="16dp"
        android:background="#EFE7DB"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:padding="4dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="@+id/imageView_restaurant_list"
        app:layout_constraintTop_toBottomOf="@+id/imageView_restaurant_list"
        app:srcCompat="@drawable/sleep_button" />

    <ImageView
        android:id="@+id/imageView_restaurant_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:background="#EFE7DB"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:padding="4dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/imageView_restaurant_list"
        app:layout_constraintStart_toStartOf="@+id/imageView_restaurant_upgrade"
        app:layout_constraintTop_toBottomOf="@+id/imageView_restaurant_upgrade"
        app:srcCompat="@drawable/avatar" />

    <ImageView
        android:id="@+id/imageView_restaurant_upgrade"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="8dp"
        android:background="#EEE8DA"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:padding="4dp"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toTopOf="@+id/imageView_restaurant_avatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"
        app:srcCompat="@drawable/upgrade" />

</androidx.constraintlayout.widget.ConstraintLayout>